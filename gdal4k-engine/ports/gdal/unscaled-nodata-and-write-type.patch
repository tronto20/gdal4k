+// Compute element strides for a packed native buffer independently of caller
+// strides: explicit (including zero) caller strides do not bound count's product.
+static bool GetUnscaledBufferLayout(
+    size_t nDims, const size_t *count, size_t nParentDTSize,
+    const GPtrDiff_t *bufferStride, size_t nBufferDTSize,
+    std::vector<GPtrDiff_t> &anPackedStride,
+    std::vector<GPtrDiff_t> &anBufferByteStride, size_t &nElts)
+{
+    const auto nMaxOffset = std::numeric_limits<GPtrDiff_t>::max();
+    const auto nMinOffset = std::numeric_limits<GPtrDiff_t>::min();
+    if (nParentDTSize == 0 || nBufferDTSize == 0 ||
+        nBufferDTSize > static_cast<size_t>(nMaxOffset))
+    {
+        CPLError(CE_Failure, CPLE_AppDefined,
+                 "Invalid data type size for an unscaled view");
+        return false;
+    }
+    const size_t nMaxElts =
+        std::min(std::numeric_limits<size_t>::max() / nParentDTSize,
+                 static_cast<size_t>(nMaxOffset) / nParentDTSize);
+    nElts = 1;
+    anPackedStride.resize(nDims);
+    anBufferByteStride.resize(nDims);
+    const auto nBufferSize = static_cast<GPtrDiff_t>(nBufferDTSize);
+    for (size_t i = nDims; i > 0;)
+    {
+        --i;
+        if (count[i] == 0 || nElts > nMaxElts / count[i])
+        {
+            CPLError(CE_Failure, CPLE_OutOfMemory,
+                     "Too many values in an unscaled view request");
+            return false;
+        }
+        anPackedStride[i] = static_cast<GPtrDiff_t>(nElts);
+        nElts *= count[i];
+        if (bufferStride[i] > nMaxOffset / nBufferSize ||
+            bufferStride[i] < nMinOffset / nBufferSize)
+        {
+            CPLError(CE_Failure, CPLE_AppDefined,
+                     "Buffer stride overflows an unscaled view byte offset");
+            return false;
+        }
+        anBufferByteStride[i] = bufferStride[i] * nBufferSize;
+    }
+    return true;
+}
