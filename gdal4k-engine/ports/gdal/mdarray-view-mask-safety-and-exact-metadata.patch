+
+// Parse the supported signed-64 slice grammar without saturating conversions
+// or negating INT64_MIN. Magnitudes are also useful for negative indexes.
+static bool ParseSliceInteger(const char *pszText, GInt64 &nValue)
+{
+    const bool bNegative = *pszText == '-';
+    if (*pszText == '-' || *pszText == '+')
+        ++pszText;
+    if (!*pszText)
+        return false;
+    GUInt64 nMagnitude = 0;
+    const GUInt64 nLimit =
+        static_cast<GUInt64>(std::numeric_limits<GInt64>::max()) +
+        (bNegative ? 1 : 0);
+    for (; *pszText; ++pszText)
+    {
+        if (*pszText < '0' || *pszText > '9')
+            return false;
+        const auto nDigit = static_cast<GUInt64>(*pszText - '0');
+        if (nMagnitude > (nLimit - nDigit) / 10)
+            return false;
+        nMagnitude = nMagnitude * 10 + nDigit;
+    }
+    nValue = bNegative
+                 ? (nMagnitude == nLimit
+                        ? std::numeric_limits<GInt64>::min()
+                        : -static_cast<GInt64>(nMagnitude))
+                 : static_cast<GInt64>(nMagnitude);
+    return true;
+}
+
+static GUInt64 SliceMagnitude(GInt64 nValue)
+{
+    return nValue < 0 ? static_cast<GUInt64>(-(nValue + 1)) + 1
+                      : static_cast<GUInt64>(nValue);
+}
 
