+struct GDALMDArrayMaskValue
+{
+    bool bHasValue = false;
+    double dfValue = 0;
+    GDALDataType eExactType = GDT_Unknown;
+    GInt64 nSigned = 0;
+    GUInt64 nUnsigned = 0;
+};
+
+static bool ReadMaskAttributeValues(const std::shared_ptr<GDALAttribute> &poAttr,
+                                    size_t nCount,
+                                    GDALMDArrayMaskValue *pasValues)
+{
+    const auto &dt = poAttr->GetDataType();
+    const auto raw = poAttr->ReadAsRaw();
+    if (dt.GetSize() == 0 || raw.size() != nCount * dt.GetSize())
+    {
+        CPLError(CE_Failure, CPLE_AppDefined,
+                 "Cannot read mask attribute %s", poAttr->GetName().c_str());
+        return false;
+    }
+    const auto eType = dt.GetNumericDataType();
+    for (size_t i = 0; i < nCount; ++i)
+    {
+        auto &value = pasValues[i];
+        value.bHasValue = true;
+        const auto pRaw = raw.data() + i * dt.GetSize();
+        GDALCopyWords64(pRaw, eType, 0, &value.dfValue, GDT_Float64, 0, 1);
+        if (eType == GDT_Int64)
+        {
+            value.eExactType = eType;
+            memcpy(&value.nSigned, pRaw, sizeof(value.nSigned));
+        }
+        else if (eType == GDT_UInt64)
+        {
+            value.eExactType = eType;
+            memcpy(&value.nUnsigned, pRaw, sizeof(value.nUnsigned));
+        }
+    }
+    return true;
+}
