// Offline adapter for the exact GDAL handoff blocks inserted below.
// GDAL value conversion, SQLite execution and Arrow allocations are stubbed;
// producer/consumer locking, predicates, notifications and joins are upstream.
#include <atomic>
#include <cassert>
#include <cerrno>
#include <chrono>
#include <condition_variable>
#include <cstdint>
#include <ctime>
#include <future>
#include <iostream>
#include <memory>
#include <mutex>
#include <string>
#include <thread>
#include <utility>
#include <vector>

struct ArrowArray
{
    std::vector<int> values{};
    std::vector<int> shrinks{};
    int clearCount = 0;
    bool releaseCalled = false;
    static void Release(ArrowArray *array)
    {
        array->releaseCalled = true;
        array->values.clear();
        array->release = nullptr;
    }
    void (*release)(ArrowArray *) = Release;
};
struct OGRArrowArrayHelper
{
    ArrowArray *array;
    int m_nMaxBatchSize = 3;
    explicit OGRArrowArrayHelper(ArrowArray *value) : array(value) {}
    void Shrink(int rows)
    {
        assert(rows >= 0 && static_cast<size_t>(rows) <= array->values.size());
        array->values.resize(rows);
        array->shrinks.push_back(rows);
    }
    void ClearArray()
    {
        ++array->clearCount;
        array->values.clear();
        array->release = nullptr;
    }
};
